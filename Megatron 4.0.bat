@echo off
chcp 65001 >nul
setlocal DisableDelayedExpansion
set "LOCAL_VERSION=1.9.9d_auto_standalone"

if "%~1"=="admin" (
    call :check_command chcp
    call :check_command find
    call :check_command findstr
    call :check_command netsh
    call :load_user_lists
    echo Started with admin rights
) else (
    call :check_extracted
    call :check_command powershell
    echo Requesting admin rights...
    powershell -NoProfile -Command "Start-Process 'cmd.exe' -ArgumentList '/c \"\"%~f0\" admin\"' -Verb RunAs"
    exit /b
)

cd /d "%~dp0"
set "BIN_PATH=%~dp0bin\"
set "LISTS_PATH=%~dp0lists\"

call :tcp_enable
call :game_switch_status

echo.
echo ==================================================
echo    ZAPRET AUTO-INSTALLER (MEGATRON V4.0)
echo ==================================================
echo.

:menu
echo Select an action
echo 1 - Fix youtube
echo 2 - Fix discord
echo 3 - Fix youtube and discord (recomend)
echo.
set /p "USER_CHOICE=Select (1-3): "

if "%USER_CHOICE%"=="1" (
    set "CHECK_YT=1"
    set "CHECK_DS=0"
) else if "%USER_CHOICE%"=="2" (
    set "CHECK_YT=0"
    set "CHECK_DS=1"
) else if "%USER_CHOICE%"=="3" (
    set "CHECK_YT=1"
    set "CHECK_DS=1"
) else (
    echo Invalid input. Please select 1, 2, or 3
    echo.
    goto menu
)

set "STRAT_COUNT=0"
for /f "tokens=1,* delims=:" %%A in ('findstr /b "STRAT:" "%~f0"') do (
    set /a STRAT_COUNT+=1
)

if %STRAT_COUNT%==0 (
    echo [ERROR] No embedded strategies found!
    pause
    exit /b
)

echo.
echo Found %STRAT_COUNT% embedded strategies. Starting tests...
echo.

set "CURRENT_STRAT=0"
for /f "tokens=1,* delims=:" %%A in ('findstr /b "STRAT:" "%~f0"') do (
    set "RAW_ARGS=%%B"
    call :test_strategy
)

echo.
echo ==================================================
echo [ERROR] All %STRAT_COUNT% strategies failed to connect.
echo Your ISP might be using a DPI that requires a custom configuration.
echo ==================================================
pause
exit /b


:test_strategy
setlocal EnableDelayedExpansion
set /a CURRENT_STRAT+=1
echo --------------------------------------------------
echo [!CURRENT_STRAT!/%STRAT_COUNT%] Testing strategy #!CURRENT_STRAT!...

set "ARGS=!RAW_ARGS!"
set "ARGS=!ARGS:%%BIN%%=%BIN_PATH%!"
set "ARGS=!ARGS:%%LISTS%%=%LISTS_PATH%!"
set "ARGS=!ARGS:"=\"!"
set "ARGS=!ARGS:%%GameFilterTCP%%=%GameFilterTCP%!"
set "ARGS=!ARGS:%%GameFilterUDP%%=%GameFilterUDP%!"

set "SRVCNAME=zapret"

net stop !SRVCNAME! >nul 2>&1
sc delete !SRVCNAME! >nul 2>&1
net stop "WinDivert" >nul 2>&1

sc create !SRVCNAME! binPath= "\"%BIN_PATH%winws.exe\" !ARGS!" DisplayName= "zapret" start= auto >nul
sc description !SRVCNAME! "Zapret DPI bypass software" >nul
sc start !SRVCNAME! >nul

echo Waiting 3 seconds for service and WinDivert to initialize...
timeout /t 3 /nobreak >nul

if "!CHECK_YT!"=="0" goto skip_yt
echo Pinging YouTube...
curl -I -s -m 5 "https://www.youtube.com" | findstr /C:"HTTP/" >nul
if !errorlevel! neq 0 (
    echo - YouTube check failed.
    goto cleanup_fail
)
echo + YouTube OK.
:skip_yt

if "!CHECK_DS!"=="0" goto skip_ds
echo Pinging Discord...
curl -I -s -m 5 "https://discord.com" | findstr /C:"HTTP/" >nul
if !errorlevel! neq 0 (
    echo - Discord check failed.
    goto cleanup_fail
)
echo + Discord OK.
:skip_ds

goto success_found

:cleanup_fail
powershell -Command "Write-Host 'echo [FAILED] Strategy #!CURRENT_STRAT! did not bypass DPI.' -ForegroundColor Red"
//echo [FAILED] Strategy #!CURRENT_STRAT! did not bypass DPI.
endlocal & set "CURRENT_STRAT=%CURRENT_STRAT%"
exit /b

:success_found
echo.
powershell -Command "Write-Host 'echo [SUCCESS] Strategy #!CURRENT_STRAT! works perfectly' -ForegroundColor Green"
//echo [SUCCESS] Strategy #!CURRENT_STRAT! works perfectly!
if "!CHECK_YT!"=="1" if "!CHECK_DS!"=="1" echo Both YouTube and Discord are accessible.
if "!CHECK_YT!"=="1" if "!CHECK_DS!"=="0" echo YouTube is accessible.
if "!CHECK_YT!"=="0" if "!CHECK_DS!"=="1" echo Discord is accessible.
reg add "HKLM\System\CurrentControlSet\Services\zapret" /v zapret-discord-youtube /t REG_SZ /d "standalone_strat_!CURRENT_STRAT!" /f >nul
echo Exiting in 10 seconds...
timeout /t 10 /nobreak >nul
exit


:tcp_enable
chcp 437 > nul
netsh interface tcp show global | findstr /i "timestamps" | findstr /i "enabled" > nul || netsh interface tcp set global timestamps=enabled > nul 2>&1
exit /b

:load_user_lists
set "LISTS_PATH=%~dp0lists\"
if not exist "%LISTS_PATH%ipset-exclude-user.txt" echo 203.0.113.113/32>"%LISTS_PATH%ipset-exclude-user.txt"
if not exist "%LISTS_PATH%list-general-user.txt" (
    echo # Never leave this file empty>"%LISTS_PATH%list-general-user.txt"
    echo domain.example.abc>>"%LISTS_PATH%list-general-user.txt"
)
if not exist "%LISTS_PATH%list-exclude-user.txt" echo domain.example.abc>"%LISTS_PATH%list-exclude-user.txt"
exit /b

:game_switch_status
set "gameFlagFile=%~dp0utils\game_filter.enabled"
if not exist "%gameFlagFile%" (
    set "GameFilter=12"
    set "GameFilterTCP=12"
    set "GameFilterUDP=12"
    exit /b
)
set "GameFilterMode="
for /f "usebackq delims=" %%A in ("%gameFlagFile%") do if not defined GameFilterMode set "GameFilterMode=%%A"
if /i "%GameFilterMode%"=="all" (
    set "GameFilter=1024-65535" & set "GameFilterTCP=1024-65535" & set "GameFilterUDP=1024-65535"
) else if /i "%GameFilterMode%"=="tcp" (
    set "GameFilter=1024-65535" & set "GameFilterTCP=1024-65535" & set "GameFilterUDP=12"
) else (
    set "GameFilter=1024-65535" & set "GameFilterTCP=12" & set "GameFilterUDP=1024-65535"
)
exit /b

:check_command
where %1 >nul 2>&1
if %errorLevel% neq 0 (
    echo [ERROR] %1 not found in PATH
    pause
    exit /b 1
)
exit /b 0

:check_extracted
if not exist "%~dp0bin\" (
    echo Zapret must be extracted from archive first or bin folder not found.
    pause
    exit
)
exit /b 0

